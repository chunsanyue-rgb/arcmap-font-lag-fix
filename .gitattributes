# normalise text line endings, keep binaries intact
* text=auto eol=lf

*.c      text eol=lf
*.h      text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.ini    text eol=crlf
*.bat    text eol=crlf
*.txt    text eol=crlf

*.dll    binary
*.exe    binary
*.zip    binary
*.msp    binary
*.svg    text eol=lf
